+/*
+ * Helper function to add a bytes object built from the given buffer to
+ * a dict under the given key.
+ */
+static int
+python_dict_add_bytes(PyObject *dict, const char *name,
+    const u_int8_t *data, size_t len)
+{
+	PyObject	*obj;
+
+	PRECOND(dict != NULL);
+	PRECOND(name != NULL);
+	PRECOND(data != NULL);
+
+	if ((obj = PyBytes_FromStringAndSize((const char *)data, len)) == NULL)
+		return (-1);
+
+	if (PyDict_SetItemString(dict, name, obj) == -1) {
+		Py_DECREF(obj);
+		return (-1);
+	}
+
+	Py_DECREF(obj);
+
+	return (0);
+}
 
