 /*
+ * Entry from python for an allocated context cathedral_liturgy().
+ *
+ * Without arguments we are interested in all peers of our flock, with
+ * a KYRKA_PEERS_PER_FLOCK byte long object we tell the cathedral which
+ * peers we want to hear about.
+ */
+static PyObject *
+pykyrka_cathedral_liturgy(PyObject *self, PyObject *args)
+{
+	Py_buffer		buf;
+	struct pykyrka		*ctx;
+	int			ret;
+
+	PRECOND(self != NULL);
+	PRECOND(args != NULL);
+
+	memset(&buf, 0, sizeof(buf));
+
+	if (!PyArg_ParseTuple(args, "|y*", &buf))
+		return (NULL);
+
+	ctx = (struct pykyrka *)self;
+
+	if (buf.obj != NULL && buf.len != KYRKA_PEERS_PER_FLOCK) {
+		PyBuffer_Release(&buf);
+		PyErr_Format(PyExc_RuntimeError, "peers must be %u bytes",
+		    (unsigned int)KYRKA_PEERS_PER_FLOCK);
+		return (NULL);
+	}
+
+	ret = kyrka_cathedral_liturgy(ctx->kyrka, buf.buf, buf.len);
+
+	PyBuffer_Release(&buf);
+
+	if (ret == -1) {
+		python_kyrka_exception(kyrka_last_error(ctx->kyrka));
+		return (NULL);
+	}
+
+	Py_RETURN_TRUE;
+}
