+static int		remembrance_cathedrals(PyObject *,
+			    const struct kyrka_event_remembrance *);
+
+/*
+ * Turn the cathedrals of a remembrance into a list of (ip, port) tuples,
+ * the ip in the same host order integer the peer discovery event uses.
+ */
+static int
+remembrance_cathedrals(PyObject *dict,
+    const struct kyrka_event_remembrance *rem)
+{
+	int			i;
+	PyObject		*list, *entry, *obj;
+
+	PRECOND(dict != NULL);
+	PRECOND(rem != NULL);
+
+	if ((list = PyList_New(0)) == NULL)
+		return (-1);
+
+	for (i = 0; i < KYRKA_CATHEDRALS_MAX; i++) {
+		if (rem->ips[i] == 0)
+			continue;
+
+		if ((entry = PyTuple_New(2)) == NULL)
+			goto failure;
+
+		if ((obj = PyLong_FromUnsignedLongLong(rem->ips[i])) == NULL) {
+			Py_DECREF(entry);
+			goto failure;
+		}
+
+		PyTuple_SET_ITEM(entry, 0, obj);
+
+		if ((obj = PyLong_FromUnsignedLongLong(rem->ports[i])) == NULL) {
+			Py_DECREF(entry);
+			goto failure;
+		}
+
+		PyTuple_SET_ITEM(entry, 1, obj);
+
+		if (PyList_Append(list, entry) == -1) {
+			Py_DECREF(entry);
+			goto failure;
+		}
+
+		Py_DECREF(entry);
+	}
+
+	if (PyDict_SetItemString(dict, "cathedrals", list) == -1)
+		goto failure;
+
+	Py_DECREF(list);
+
+	return (0);
+
+failure:
+	Py_DECREF(list);
+
+	return (-1);
+}
